FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Get a free key from https://aistudio.google.com/apikey
# Never commit the real key or enable billing for this project.
GOOGLE_API_KEY=

# DeepBrief intentionally uses one free-tier model with no paid fallback.
GEMINI_MODEL=gemini-3.5-flash-lite

# Tavily web search runs in free keyless mode; no search API key is required.

